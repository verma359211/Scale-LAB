{
  "name": "system-design-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "load:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-load-test.ps1",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
