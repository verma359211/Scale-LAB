      "targets": [
        { "refId": "A", "expr": "sum(rate(scalelab_http_request_duration_seconds_sum{instance_id=~\"$instance\"}[30s])) / clamp_min(sum(rate(scalelab_http_request_duration_seconds_count{instance_id=~\"$instance\"}[30s])), 0.000000001)", "legendFormat": "average" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(scalelab_http_request_duration_seconds_bucket{instance_id=~\"$instance\"}[30s])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(scalelab_http_request_duration_seconds_bucket{instance_id=~\"$instance\"}[30s])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
