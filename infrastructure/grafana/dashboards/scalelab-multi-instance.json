      "type": "timeseries", "title": "Total Node CPU (selected instances)", "id": 30,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 72 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * (sum(rate(scalelab_node_process_cpu_user_seconds_total{instance_id=~\"$instance\"}[30s])) + sum(rate(scalelab_node_process_cpu_system_seconds_total{instance_id=~\"$instance\"}[30s])))", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "single" } }
