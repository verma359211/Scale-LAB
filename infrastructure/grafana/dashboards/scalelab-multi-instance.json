{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "text", "title": "Live architecture", "id": 1,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "### ScaleLab request path\n\n```text\nClient / k6\n     ↓\n Nginx :3001\n  ↙   ↓   ↘\napi-1 api-2 api-3\n3101  3102  3103\n  ↘   ↓   ↙\nPostgreSQL :5433\n```\n\nPrometheus scrapes each API directly."
      }
    },
    {
      "type": "stat", "title": "API target health", "id": 2,
      "gridPos": { "h": 7, "w": 5, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"scalelab-api\",api_instance=~\"$instance\"}", "legendFormat": "{{api_instance}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Total requests / second", "id": 3,
      "gridPos": { "h": 7, "w": 5, "x": 13, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s]))", "legendFormat": "RPS" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Total active requests", "id": 4,
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(scalelab_http_requests_active{instance_id=~\"$instance\"}) or vector(0)", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "timeseries", "title": "RPS by API instance", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (instance_id) (rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s]))", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Traffic share by API instance", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * sum by (instance_id) (rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s])) / scalar(clamp_min(sum(rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s])), 0.000000001))", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Average response time by instance", "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (instance_id) (rate(scalelab_http_request_duration_seconds_sum{instance_id=~\"$instance\"}[30s])) / clamp_min(sum by (instance_id) (rate(scalelab_http_request_duration_seconds_count{instance_id=~\"$instance\"}[30s])), 0.000000001)", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "p95 / p99 response time by instance", "id": 8,
      "gridPos": { "h": 8, "w": 10, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, instance_id) (rate(scalelab_http_request_duration_seconds_bucket{instance_id=~\"$instance\"}[30s])))", "legendFormat": "{{instance_id}} p95" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le, instance_id) (rate(scalelab_http_request_duration_seconds_bucket{instance_id=~\"$instance\"}[30s])))", "legendFormat": "{{instance_id}} p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "HTTP error rate by instance", "id": 9,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "(100 * sum by (instance_id) (rate(scalelab_http_requests_total{instance_id=~\"$instance\",status_code=~\"4..|5..\"}[30s])) / clamp_min(sum by (instance_id) (rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s])), 0.000000001)) or on(instance_id) (0 * sum by (instance_id) (rate(scalelab_http_requests_total{instance_id=~\"$instance\"}[30s])))", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Node CPU by instance", "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "100 * (sum by (instance_id) (rate(scalelab_node_process_cpu_user_seconds_total{instance_id=~\"$instance\"}[30s])) + sum by (instance_id) (rate(scalelab_node_process_cpu_system_seconds_total{instance_id=~\"$instance\"}[30s])))", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Resident memory by instance", "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "scalelab_node_process_resident_memory_bytes{instance_id=~\"$instance\"}", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Event-loop lag by instance", "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "scalelab_node_nodejs_eventloop_lag_seconds{instance_id=~\"$instance\"}", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Active requests by instance", "id": 13,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "scalelab-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (instance_id) (scalelab_http_requests_active{instance_id=~\"$instance\"})", "legendFormat": "{{instance_id}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Pool connections by instance", "id": 14,
